/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_MFCMARKDOWNEDITOR_DIALOG DIALOGEX 0, 0, 374, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Markdown 编辑器"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    EDITTEXT            IDC_EDIT_MARKDOWN,7,7,180,236,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_WANTRETURN | WS_VSCROLL | WS_HSCROLL
    CONTROL             "",IDC_HTML_PREVIEW,"Static",SS_WHITERECT | WS_CHILD | WS_VISIBLE | WS_BORDER,187,7,180,236
END

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU_MAIN MENU
BEGIN
    POPUP "文件 (&F)"
    BEGIN
        MENUITEM "新建\tCtrl+N",                ID_FILE_NEW
        MENUITEM "打开\tCtrl+O",                ID_FILE_OPEN
        MENUITEM "保存\tCtrl+S",                ID_FILE_SAVE
        MENUITEM "另存为...",                   ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "退出",                        ID_FILE_EXIT
    END
    POPUP "编辑 (&E)"
    BEGIN
        MENUITEM "撤销\tCtrl+Z",                ID_EDIT_UNDO
        MENUITEM "重做\tCtrl+Y",                ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "剪切\tCtrl+X",                ID_EDIT_CUT
        MENUITEM "复制\tCtrl+C",                ID_EDIT_COPY
        MENUITEM "粘贴\tCtrl+V",                ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "全选\tCtrl+A",                ID_EDIT_SELECT_ALL
    END
    POPUP "视图 (&V)"
    BEGIN
        MENUITEM "全屏",                        ID_VIEW_FULLSCREEN
        MENUITEM "刷新预览",                    ID_VIEW_REFRESH
    END
    POPUP "格式 (&O)"
    BEGIN
        MENUITEM "粗体",                        ID_FORMAT_BOLD
        MENUITEM "斜体",                        ID_FORMAT_ITALIC
        MENUITEM SEPARATOR
        MENUITEM "一级标题",                    ID_FORMAT_HEADING1
        MENUITEM "二级标题",                    ID_FORMAT_HEADING2
        MENUITEM "三级标题",                    ID_FORMAT_HEADING3
        MENUITEM SEPARATOR
        MENUITEM "代码",                        ID_FORMAT_CODE
        MENUITEM "列表",                        ID_FORMAT_LIST
    END
    POPUP "工具 (&T)"
    BEGIN
        MENUITEM "选项...",                     ID_TOOLS_OPTIONS
    END
    POPUP "帮助 (&H)"
    BEGIN
        MENUITEM "关于 Markdown 编辑器",         ID_HELP_ABOUT
    END
END


