/* MarkEdit 应用程序样式表 */

/* 使用原生 Windows 菜单样式 - 不设置 text-align 以保留默认行为 */
/* 默认显示快捷字母但无下划线，按下 Alt 键时显示下划线 */

/* 状态栏样式 */
QStatusBar {
    background-color: #f8f9fa;
    border-top: 1px solid #e0e0e0;
}

QStatusBar::item {
    border: none;
}

/* 工具提示样式 */
QToolTip {
    background-color: #333;
    color: white;
    border: 1px solid #555;
    border-radius: 3px;
    padding: 4px 8px;
}
